# Everything not listed here ships in the VSIX. The only files loaded from disk
# at runtime are the chat panel's script and styles in media/, so out/, media/,
# images/, README.md and LICENSE are what is needed (package.json is always
# included by vsce).

# Sources — compiled output in out/ is what ships.
src/**
test/**
**/*.ts
**/*.map
**/*.patch

# Build & tooling config
tsconfig.json
tsconfig.test.json
jest.config.js
.github/**
.vscode/**
.vscode-test/**

# Local tooling & editor state
.claude/**
.gitignore
.vscodeignore

# OS cruft and previous builds
.DS_Store
**/.DS_Store
*.vsix

# Project website, published separately through GitHub Pages
docs/**
